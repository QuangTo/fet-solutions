DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=true
# Required in production — used to sign httpOnly session cookies (32+ random bytes). openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string - 
# Dev only: allow curl/scripts to pass x-user-id headers without a cookie.
# LMS_ALLOW_HEADER_AUTH=true
API_PORT=4175
CORS_ORIGIN=http://127.0.0.1:4174
BILLING_BANK_NAME=Vietcombank
BILLING_BANK_CODE=VCB
BILLING_ACCOUNT_NUMBER=9373665129
BILLING_ACCOUNT_NAME=To Van Quang
# QR tĩnh fallback khi không tạo được VietQR động.
BILLING_BANK_QR_URL=/qr-bank.png
BILLING_MOMO_QR_URL=/qr-momo.png
BILLING_MOMO_PHONE=0901234567
# Deprecated: chỉ cần khi ngân hàng không map được bằng BILLING_BANK_NAME/CODE.
# BILLING_BANK_BIN=970436

# Telegram bot duyệt thanh toán manual QR.
TELEGRAM_CHAT_ID=123456789
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
# Tạo chuỗi random và dùng cùng giá trị này khi setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
